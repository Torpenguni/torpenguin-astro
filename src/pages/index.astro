---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { topics } from '../data/topics';

const entries = await getCollection('essays', ({ data }) => !data.draft);
entries.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const essays = entries.map((e) => ({
  slug: e.slug,
  title: e.data.title,
  dek: e.data.dek,
  topic: e.data.topic,
  tag: e.data.tag,
  author: e.data.author,
  date: e.data.date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }),
  readTime: e.data.readTime,
}));

const featured = essays[0];
const sidebar = essays.slice(1, 4);
const more = essays.slice(4);

const topicList = topics.map((t) => ({
  ...t,
  count: entries.filter((e) => e.data.topic === t.slug).length,
}));
---

<BaseLayout
  title="Torpenguin — Notes on building F&B in Asia"
  description="Essays on building, operating, and scaling food & beverage businesses — by Torpenguin, founder of Penguin Eat Shabu (40+ outlets, Bangkok)."
>
  <!-- INTRO BAND -->
  <section class="intro">
    <div class="container">
      <p class="intro-text">
        I'm <strong>Torpenguin</strong>. I built <strong>Penguin Eat Shabu</strong> — 40+ outlets
        across Bangkok — and I write here about what building, operating, and scaling
        food &amp; beverage actually takes.
      </p>
    </div>
  </section>

  {featured && (
    <section class="top-grid">
      <div class="container">
        <div class="top-grid-inner">
          <article class="featured-tout">
            <a href={`/essays/${featured.slug}`} class="featured-image-link">
              <div class="featured-image" aria-hidden="true">
                <span class="featured-pill">{featured.tag}</span>
              </div>
            </a>
            <div class="featured-content">
              <h2 class="featured-headline">
                <a href={`/essays/${featured.slug}`}>{featured.title}</a>
              </h2>
              <p class="featured-dek">{featured.dek}</p>
              <div class="featured-byline">
                <span>{featured.date}</span>
                <span class="byline-sep">·</span>
                <span>{featured.readTime}</span>
              </div>
            </div>
          </article>

          <aside class="fascinating-reads">
            <h3 class="sidebar-title">More essays</h3>
            <ul class="fascinating-list">
              {sidebar.map((item) => (
                <li class="fascinating-item">
                  <a href={`/essays/${item.slug}`} class="fascinating-link">
                    <span class="fascinating-tag">{item.tag}</span>
                    <span class="fascinating-headline">{item.title}</span>
                    <span class="fascinating-meta">{item.date} · {item.readTime}</span>
                  </a>
                </li>
              ))}
              {sidebar.length === 0 && (
                <li class="fascinating-item">
                  <span class="fascinating-meta">More essays coming soon.</span>
                </li>
              )}
            </ul>
            <a href="/essays" class="sidebar-more">All essays →</a>
          </aside>
        </div>
      </div>
    </section>
  )}

  {more.length > 0 && (
    <section class="flood-zone">
      <div class="container">
        <div class="section-head">
          <h2 class="section-title">More writing</h2>
          <a href="/essays" class="section-more">All essays →</a>
        </div>
        <div class="flood-grid">
          {more.map((a) => (
            <article class="flood-card">
              <div class="flood-image" aria-hidden="true"></div>
              <a href={`/essays/${a.topic}`} class="tag-link">{a.tag}</a>
              <h3 class="flood-headline">
                <a href={`/essays/${a.slug}`}>{a.title}</a>
              </h3>
              <p class="flood-dek">{a.dek}</p>
              <div class="flood-meta">{a.date}</div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- TOPICS -->
  <section class="topics-zone">
    <div class="container">
      <div class="section-head">
        <h2 class="section-title">Browse by topic</h2>
        <a href="/topics" class="section-more">All topics →</a>
      </div>
      <div class="topics-grid">
        {topicList.map((t) => (
          <a href={t.count > 0 ? `/essays/${t.slug}` : '#subscribe'} class="topic-card">
            <div class="topic-card-label">{t.label}</div>
            <p class="topic-card-desc">{t.description}</p>
            <div class="topic-card-count">{t.count} {t.count === 1 ? 'essay' : 'essays'} →</div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* INTRO */
  .intro {
    padding: 36px 0 28px;
    border-bottom: 1px solid var(--hairline);
  }
  .intro-text {
    font-family: var(--font-serif);
    font-size: clamp(20px, 2.4vw, 26px);
    line-height: 1.5;
    color: var(--ink);
    max-width: 880px;
  }
  .intro-text strong {
    font-weight: 600;
  }

  .tag-link {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    text-decoration: none;
    border-bottom: none;
    margin-bottom: 8px;
    transition: color 0.15s ease;
  }
  .tag-link:hover { color: var(--accent-deep); }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-top: 2px solid var(--ink);
    padding-top: 16px;
    margin-bottom: 28px;
  }
  .section-title {
    font-family: var(--font-sans);
    font-size: clamp(28px, 3vw, 36px);
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--ink);
    line-height: 1;
  }
  .section-more {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    color: var(--ink-soft);
    text-decoration: none;
    border-bottom: none;
    transition: color 0.15s ease;
  }
  .section-more:hover { color: var(--accent); }

  /* TOP GRID */
  .top-grid {
    padding: 32px 0 48px;
    border-bottom: 1px solid var(--hairline);
  }
  .top-grid-inner {
    display: grid;
    grid-template-columns: 1.55fr 1fr;
    gap: 48px;
  }
  .featured-tout { display: flex; flex-direction: column; }
  .featured-image-link {
    display: block;
    text-decoration: none;
    border-bottom: none;
    margin-bottom: 18px;
    transition: opacity 0.15s ease;
  }
  .featured-image-link:hover { opacity: 0.92; }
  .featured-image {
    position: relative;
    width: 100%;
    aspect-ratio: 4/3;
    background: linear-gradient(135deg, var(--paper-mute) 0%, var(--paper-warm) 100%);
    overflow: hidden;
  }
  .featured-pill {
    position: absolute;
    top: 16px;
    left: 16px;
    display: inline-block;
    background: var(--accent);
    color: var(--paper);
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 6px 10px;
    border-radius: 2px;
  }
  .featured-headline {
    font-family: var(--font-sans);
    font-size: clamp(28px, 3.4vw, 44px);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--ink);
    margin: 0 0 14px;
  }
  .featured-headline a {
    color: inherit;
    text-decoration: none;
    border-bottom: none;
    transition: color 0.15s ease;
  }
  .featured-headline a:hover { color: var(--accent); }
  .featured-dek {
    font-family: var(--font-serif);
    font-size: 17px;
    line-height: 1.5;
    color: var(--ink-soft);
    margin-bottom: 14px;
    max-width: 620px;
  }
  .featured-byline {
    display: flex;
    gap: 8px;
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--ink-faint);
    font-weight: 500;
  }
  .byline-sep { color: var(--ink-mute); }

  .sidebar-title {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink);
    border-bottom: 2px solid var(--ink);
    padding-bottom: 10px;
    margin-bottom: 4px;
  }
  .fascinating-reads { display: flex; flex-direction: column; }
  .fascinating-list { list-style: none; padding: 0; margin: 0; }
  .fascinating-item {
    border-bottom: 1px solid var(--hairline);
    padding: 18px 0;
  }
  .fascinating-link {
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-decoration: none;
    border-bottom: none;
    color: inherit;
  }
  .fascinating-tag {
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .fascinating-headline {
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 700;
    line-height: 1.25;
    color: var(--ink);
    letter-spacing: -0.01em;
    transition: color 0.15s ease;
  }
  .fascinating-link:hover .fascinating-headline { color: var(--accent); }
  .fascinating-meta {
    font-family: var(--font-sans);
    font-size: 11px;
    color: var(--ink-faint);
  }
  .sidebar-more {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    color: var(--ink-soft);
    text-decoration: none;
    border-bottom: none;
    padding-top: 16px;
    transition: color 0.15s ease;
  }
  .sidebar-more:hover { color: var(--accent); }

  /* FLOOD */
  .flood-zone {
    padding: 48px 0;
    border-bottom: 1px solid var(--hairline);
  }
  .flood-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px 28px;
  }
  .flood-card { display: flex; flex-direction: column; }
  .flood-image {
    width: 100%;
    aspect-ratio: 16/10;
    background: linear-gradient(135deg, var(--paper-mute) 0%, var(--paper-warm) 100%);
    margin-bottom: 14px;
  }
  .flood-headline {
    font-family: var(--font-sans);
    font-size: 19px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--ink);
    margin: 4px 0 8px;
  }
  .flood-headline a {
    color: inherit;
    text-decoration: none;
    border-bottom: none;
    transition: color 0.15s ease;
  }
  .flood-headline a:hover { color: var(--accent); }
  .flood-dek {
    font-family: var(--font-serif);
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink-soft);
    margin-bottom: 10px;
  }
  .flood-meta {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    color: var(--ink-faint);
    letter-spacing: 0.02em;
    margin-top: auto;
  }

  /* TOPICS */
  .topics-zone {
    padding: 48px 0 64px;
  }
  .topics-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border-top: 1px solid var(--hairline);
    border-left: 1px solid var(--hairline);
  }
  .topic-card {
    display: flex;
    flex-direction: column;
    padding: 24px;
    text-decoration: none;
    border-bottom: 1px solid var(--hairline);
    border-right: 1px solid var(--hairline);
    color: inherit;
    transition: background 0.15s ease;
  }
  .topic-card:hover { background: var(--paper-warm); }
  .topic-card-label {
    font-family: var(--font-sans);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--ink);
    margin-bottom: 10px;
    transition: color 0.15s ease;
  }
  .topic-card:hover .topic-card-label { color: var(--accent); }
  .topic-card-desc {
    font-family: var(--font-serif);
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink-soft);
    margin-bottom: 16px;
    flex: 1;
  }
  .topic-card-count {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  @media (max-width: 1024px) {
    .flood-grid { grid-template-columns: repeat(2, 1fr); }
    .topics-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 768px) {
    .top-grid-inner { grid-template-columns: 1fr; gap: 36px; }
    .featured-headline { font-size: 28px; }
    .flood-grid { grid-template-columns: 1fr; gap: 32px; }
    .topics-grid { grid-template-columns: 1fr; }
  }
</style>
