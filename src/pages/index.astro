---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import PostGrid from '../components/PostGrid.astro';
import VideoSection from '../components/VideoSection.astro';
import { categories } from '../data/categories';
import { allPosts, postsByCategory } from '../data/posts';
import { getLongVideos } from '../lib/youtube';

const posts = allPosts();
const feature = posts[0];
const sideList = posts.slice(1, 5);
const news = postsByCategory('news').slice(0, 4);

// Home section blocks: one row per evergreen pillar that has content.
const homeSections = ['case-studies', 'trends', 'how-to', 'feasibility', 'interviews']
  .map((slug) => ({
    cat: categories.find((c) => c.slug === slug)!,
    posts: postsByCategory(slug).slice(0, 3),
  }))
  .filter((s) => s.posts.length > 0);

const videos = await getLongVideos();
---

<BaseLayout
  title="TorPenguin | สื่อธุรกิจอาหารและร้านอาหาร"
  description="เจาะลึกธุรกิจอาหารและร้านอาหาร ข่าว ถอดบทเรียน เทรนด์ วิธีเปิดร้าน และวิเคราะห์ความคุ้มก่อนลงทุน จากคนที่ลงมือทำจริง"
>
  {/* HERO */}
  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-feature">
          <PostCard post={feature} feature={true} />
        </div>
        <aside class="hero-side">
          <div class="side-title">อ่านล่าสุด</div>
          <ul class="side-list">
            {sideList.map((p) => (
              <li>
                <a href={`/${p.category}/${p.slug}`}>{p.title}</a>
              </li>
            ))}
          </ul>
        </aside>
      </div>
    </div>
  </section>

  {/* NEWS STRIP */}
  {news.length > 0 && (
    <section class="block">
      <div class="container">
        <div class="block-head">
          <h2 class="block-title">News</h2>
          <a href="/news" class="block-more">ดูทั้งหมด →</a>
        </div>
        <PostGrid posts={news} cols={4} />
      </div>
    </section>
  )}

  {/* PER-CATEGORY BLOCKS — video section sits right under Case Studies */}
  {homeSections.map((s) => (
    <>
      <section class="block">
        <div class="container">
          <div class="block-head">
            <div>
              <h2 class="block-title">{s.cat.label}</h2>
              <p class="block-intent">{s.cat.intent}</p>
            </div>
            <a href={`/${s.cat.slug}`} class="block-more">ดูทั้งหมด →</a>
          </div>
          <PostGrid posts={s.posts} cols={3} />
        </div>
      </section>
      {s.cat.slug === 'case-studies' && <VideoSection videos={videos} limit={4} />}
    </>
  ))}
</BaseLayout>

<style>
  .hero { padding: 40px 0 24px; }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.7fr 1fr;
    gap: 48px;
    align-items: start;
  }
  .side-title {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--ink);
    border-bottom: 2px solid var(--ink);
    padding-bottom: 10px;
    margin-bottom: 6px;
  }
  .side-list { list-style: none; margin: 0; padding: 0; }
  .side-list li { border-bottom: 1px solid var(--hairline); padding: 16px 0; }
  .side-list li:last-child { border-bottom: none; }
  .side-list a {
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 600;
    line-height: 1.5;
    color: var(--ink);
    text-decoration: none;
    border-bottom: none;
    transition: color 0.15s ease;
  }
  .side-list a:hover { color: var(--accent); }

  .block { padding: 40px 0; border-top: 1px solid var(--hairline); }
  .block-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
    margin-bottom: 28px;
  }
  .block-title {
    font-family: var(--font-sans);
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--ink);
    line-height: 1.1;
  }
  .block-intent { font-size: 14px; color: var(--ink-faint); margin-top: 4px; }
  .block-more {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    color: var(--ink-soft);
    text-decoration: none;
    border-bottom: none;
    white-space: nowrap;
  }
  .block-more:hover { color: var(--accent); }

  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; gap: 32px; }
  }
</style>
