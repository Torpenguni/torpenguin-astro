---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const crumbs = [
  { name: 'หน้าแรก', href: '/' },
  { name: 'เงื่อนไขการใช้งาน', href: '/terms' },
];

const sections = [
  {
    head: 'การใช้เนื้อหา',
    body: 'เนื้อหาบน TorPenguin เผยแพร่เพื่อให้ความรู้ ทุกคนอ่าน แชร์พร้อมให้เครดิต และอ้างอิงด้วยความสุจริตได้ การคัดลอกไปทั้งหมดเพื่อเผยแพร่ซ้ำหรือนำไปขายต่อ ต้องขออนุญาตเป็นลายลักษณ์อักษรก่อน',
  },
  {
    head: 'ไม่ใช่คำแนะนำการลงทุน',
    body: 'เราเล่าเรื่องธุรกิจอาหารและตัวเลขเพื่อให้เข้าใจภาพรวม ไม่มีอะไรบนเว็บนี้ถือเป็นคำแนะนำด้านการลงทุน กฎหมาย หรือภาษี ทุกคนควรตรวจสอบข้อมูลเองและปรึกษาผู้เชี่ยวชาญก่อนตัดสินใจ',
  },
  {
    head: 'ความถูกต้องและการอ้างอิง',
    body: 'เราพยายามให้ข้อมูลถูกต้องด้วยความสุจริต บางตัวเลขเป็นการประเมินหรือเรียบเรียงจากการสัมภาษณ์ ตรงไหนเป็นการประเมินเราจะบอก ถ้าผิดพลาดเราจะแก้และบันทึกการแก้ไว้',
  },
  {
    head: 'เนื้อหาที่มีผู้สนับสนุน',
    body: 'บทความที่ทำร่วมกับแบรนด์จะมีป้ายบอกชัดเจนว่าเป็นเนื้อหาร่วมกับใคร เราไม่รับรีวิวแบบแอบแฝง และยังคงมาตรฐานเดียวกับเนื้อหาปกติ',
  },
  {
    head: 'ข้อจำกัดความรับผิด',
    body: 'TorPenguin ไม่รับผิดต่อความเสียหายใดๆที่เกิดจากการนำข้อมูลบนเว็บไปใช้ เนื้อหาให้บริการตามสภาพ โดยไม่มีการรับประกันใดๆ',
  },
];
---

<BaseLayout
  title="เงื่อนไขการใช้งาน | TorPenguin"
  description="เงื่อนไขการใช้งานเว็บ TorPenguin สรุปสั้นๆ อ่านและแชร์ได้พร้อมเครดิต อย่าคัดลอกไปทั้งหมดโดยไม่ขออนุญาต และอย่าถือเป็นคำแนะนำการลงทุน"
  breadcrumbs={crumbs}
>
  <section class="legal">
    <div class="container-narrow">
      <Breadcrumb items={crumbs} />
      <h1 class="legal-h1">เงื่อนไขการใช้งาน</h1>
      <p class="legal-lead">อ่านและแชร์ได้พร้อมเครดิต อย่าคัดลอกไปทั้งหมดโดยไม่ขออนุญาต และอย่าถือเป็นคำแนะนำด้านการเงินหรือกฎหมาย รายละเอียดอยู่ด้านล่าง</p>
      {sections.map((s, i) => (
        <article class="legal-sec">
          <div class="legal-num">{String(i + 1).padStart(2, '0')}</div>
          <h2 class="legal-head">{s.head}</h2>
          <p class="legal-body">{s.body}</p>
        </article>
      ))}
      <p class="legal-contact">มีคำถาม ส่งมาที่ <a href="mailto:hello@torpenguin.com">hello@torpenguin.com</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .legal { padding: 28px 0 80px; }
  .legal-h1 { font-family: var(--font-sans); font-size: clamp(30px, 5vw, 44px); font-weight: 800; color: var(--ink); margin: 18px 0 16px; }
  .legal-lead { font-size: 18px; line-height: 1.7; color: var(--ink-soft); max-width: 680px; margin-bottom: 32px; }
  .legal-sec { padding: 28px 0; border-top: 1px solid var(--hairline); max-width: 680px; }
  .legal-num { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.1em; color: var(--accent-ink); margin-bottom: 10px; }
  .legal-head { font-family: var(--font-sans); font-size: 22px; font-weight: 700; color: var(--ink); margin-bottom: 10px; }
  .legal-body { font-size: 17px; line-height: 1.8; color: var(--ink-soft); }
  .legal-contact { margin-top: 32px; font-size: 16px; color: var(--ink-soft); }
  .legal-contact a { color: var(--accent-ink); }
</style>
