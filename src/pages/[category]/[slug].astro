---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PostGrid from '../../components/PostGrid.astro';
import YouTubeEmbed from '../../components/YouTubeEmbed.astro';
import { categoryBySlug } from '../../data/categories';
import { howToTopicBySlug } from '../../data/howto';
import {
  getAllEntries,
  getRelated,
  getAuthor,
  readingTime,
  tagSlug,
  type PostEntry,
} from '../../lib/content';

export async function getStaticPaths() {
  const all = await getAllEntries();
  return all.map((entry) => ({
    params: { category: entry.data.category, slug: entry.slug },
    props: { entry },
  }));
}

interface Props { entry: PostEntry }
const { entry } = Astro.props;
const d = entry.data;
const cat = categoryBySlug(d.category)!;
const author = getAuthor(d.author);
const related = await getRelated(entry, 4);
const { Content } = await entry.render();
const rt = readingTime(entry);

// Nicer label for How-to sub-topic tags (cost → Cost); other tags shown as-is.
const tagLabel = (t: string) => howToTopicBySlug(t)?.label ?? t;

const published = d.publishedAt;
const updated = d.updatedAt ?? null;
const fmt = (date: Date) =>
  date.toLocaleDateString('th-TH', { day: 'numeric', month: 'long', year: 'numeric' });

const crumbs = [
  { name: 'หน้าแรก', href: '/' },
  { name: cat.label, href: `/${cat.slug}` },
  { name: d.title, href: `/${d.category}/${entry.slug}` },
];

const YOUTUBE = 'https://www.youtube.com/torpenguin';
const FACEBOOK = 'https://www.facebook.com/torpenguin';
---

<BaseLayout
  title={`${d.metaTitle ?? d.title} | TorPenguin`}
  description={d.metaDescription ?? d.excerpt}
  type="article"
  isNews={d.category === 'news'}
  publishedDate={published.toISOString()}
  modifiedDate={updated?.toISOString()}
  author={author.name}
  section={cat.label}
  breadcrumbs={crumbs}
  faq={d.faq}
>
  <article class="article">
    <div class="container-narrow">
      <Breadcrumb items={crumbs} />

      {d.isSponsored && (
        <div class="sponsor-note">เนื้อหาร่วมกับ {d.sponsorName}</div>
      )}

      <a href={`/${cat.slug}`} class="art-cat">{cat.label}</a>
      <h1 class="art-h1">{d.title}</h1>
      <p class="art-excerpt">{d.excerpt}</p>

      <div class="art-meta">
        <span>โดย {author.name}</span>
        <span class="dot">·</span>
        <span>{fmt(published)}</span>
        <span class="dot">·</span>
        <span>อ่าน {rt} นาที</span>
        {updated && <><span class="dot">·</span><span>อัปเดต {fmt(updated)}</span></>}
      </div>

      {d.tags.length > 0 && (
        <div class="art-tags">
          {d.tags.map((t) => (
            <a href={`/tag/${tagSlug(t)}`} class="art-tag">{tagLabel(t)}</a>
          ))}
        </div>
      )}
    </div>

    <div class="container-narrow">
      {d.image
        ? <img class="art-cover-img" src={d.image} alt={d.title} />
        : <div class="art-cover" aria-hidden="true"></div>}
    </div>

    <div class="container-narrow">
      {d.keyPoints.length > 0 && (
        <aside class="keypoints">
          <span class="keypoints-badge">KEY POINTS</span>
          <ul class="keypoints-list">
            {d.keyPoints.map((k) => <li>{k}</li>)}
          </ul>
        </aside>
      )}

      <div class="prose">
        <Content />
      </div>

      {d.youtubeUrl && <YouTubeEmbed url={d.youtubeUrl} />}

      {d.faq.length > 0 && (
        <section class="art-faq">
          <h2 class="art-h2">คำถามที่พบบ่อย</h2>
          <dl>
            {d.faq.map((f) => (
              <div class="faq-item">
                <dt>{f.q}</dt>
                <dd>{f.a}</dd>
              </div>
            ))}
          </dl>
        </section>
      )}

      {d.sources.length > 0 && (
        <section class="source-box">
          <div class="source-title">แหล่งที่มา</div>
          <ol>
            {d.sources.map((s) => (
              <li><a href={s.url} target="_blank" rel="noopener noreferrer">{s.label}</a></li>
            ))}
          </ol>
        </section>
      )}

      <section class="author-box">
        <a href={`/author/${author.slug}`} class="author-name">{author.name}</a>
        <p class="author-bio">{author.bio}</p>
      </section>

      <section class="follow">
        <p>ถ้าเรื่องนี้มีประโยชน์ ตามอ่านและดูเรื่องอื่นของพวกเราต่อได้</p>
        <div class="follow-links">
          <a href={YOUTUBE} target="_blank" rel="noopener noreferrer">YouTube ↗</a>
          <a href={FACEBOOK} target="_blank" rel="noopener noreferrer">Facebook ↗</a>
        </div>
      </section>
    </div>

    {related.length > 0 && (
      <section class="related">
        <div class="container">
          <h2 class="related-title">บทความที่เกี่ยวข้อง</h2>
          <PostGrid posts={related} cols={4} />
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .article { padding-top: 24px; }
  .sponsor-note {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
    background: var(--accent-soft);
    padding: 6px 12px;
    border-radius: 6px;
    margin: 14px 0 4px;
  }
  .art-cat {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--accent-ink);
    text-decoration: none;
    border-bottom: none;
    margin: 14px 0 10px;
  }
  .art-h1 {
    font-family: var(--font-sans);
    font-size: clamp(30px, 5vw, 46px);
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin-bottom: 16px;
  }
  .art-excerpt { font-size: 20px; line-height: 1.7; color: var(--ink-soft); margin-bottom: 20px; }
  .art-meta {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--ink-faint);
    display: flex; flex-wrap: wrap; gap: 8px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--hairline);
  }
  .art-meta .dot { color: var(--ink-mute); }

  .art-cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    background: linear-gradient(135deg, var(--paper-mute) 0%, var(--accent-soft) 100%);
    margin: 28px 0;
  }
  .art-cover-img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 12px;
    margin: 28px 0;
    display: block;
  }
  .prose :global(img) { max-width: 100%; height: auto; border-radius: 10px; margin: 24px 0; }
  .prose :global(figure) { margin: 24px 0; }
  .prose :global(h4) { font-family: var(--font-sans); font-size: 22px; font-weight: 700; color: var(--ink); line-height: 1.35; margin: 34px 0 12px; }
  .prose :global(h5) { font-family: var(--font-sans); font-size: 20px; font-weight: 700; color: var(--ink); line-height: 1.4; margin: 30px 0 10px; }
  .prose :global(h6) { font-family: var(--font-sans); font-size: 19px; font-weight: 700; color: var(--ink); line-height: 1.4; margin: 28px 0 10px; }

  .prose { font-size: 18px; line-height: 1.8; color: var(--ink); }
  .prose :global(p) { margin-bottom: 22px; }
  .prose :global(h2) {
    font-family: var(--font-sans);
    font-size: 30px;
    font-weight: 800;
    line-height: 1.3;
    color: var(--accent-heading);
    margin: 44px 0 14px;
  }
  .prose :global(h3) {
    font-family: var(--font-sans);
    font-size: 25px;
    font-weight: 800;
    line-height: 1.3;
    color: var(--accent-heading);
    margin: 38px 0 14px;
  }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 24px 24px; }
  .prose :global(li) { margin-bottom: 8px; }
  .prose :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding: 4px 0 4px 20px;
    margin: 28px 0;
    color: var(--ink-soft);
  }
  .prose :global(a) { color: var(--accent-ink); text-decoration: underline; border-bottom: none; }

  .art-h2 {
    font-family: var(--font-sans);
    font-size: 26px;
    font-weight: 700;
    color: var(--ink);
    margin: 40px 0 16px;
  }
  .art-faq dl { margin: 0; }
  .faq-item { padding: 18px 0; border-bottom: 1px solid var(--hairline); }
  .faq-item dt { font-weight: 700; font-size: 18px; color: var(--ink); margin-bottom: 8px; }
  .faq-item dd { margin: 0; font-size: 16px; line-height: 1.8; color: var(--ink-soft); }

  .source-box {
    margin: 40px 0;
    padding: 22px 24px;
    background: var(--paper-soft);
    border-radius: 12px;
  }
  .source-title {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 12px;
  }
  .source-box ol { margin: 0; padding-left: 20px; }
  .source-box li { font-size: 14px; line-height: 1.7; color: var(--ink-soft); margin-bottom: 6px; }
  .source-box a { color: var(--ink-soft); }
  .source-box a:hover { color: var(--accent-ink); }

  .author-box { margin: 36px 0; padding-top: 24px; border-top: 1px solid var(--hairline); }
  .author-name { font-family: var(--font-sans); font-weight: 700; font-size: 17px; color: var(--ink); text-decoration: none; border-bottom: none; }
  .author-name:hover { color: var(--accent-ink); }
  .author-bio { font-size: 15px; line-height: 1.8; color: var(--ink-soft); margin-top: 6px; }

  .follow {
    margin: 36px 0;
    padding: 24px;
    background: var(--ink);
    border-radius: 12px;
    color: #fff;
  }
  .follow p { font-size: 16px; margin-bottom: 14px; }
  .follow-links { display: flex; gap: 16px; }
  .follow-links a {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 15px;
    color: var(--accent-ink);
    text-decoration: none;
    border-bottom: none;
  }

  .related { margin-top: 56px; padding: 48px 0 16px; border-top: 1px solid var(--hairline); }
  .related-title { font-family: var(--font-sans); font-size: 24px; font-weight: 800; color: var(--ink); margin-bottom: 28px; }

  /* KEY POINTS summary box */
  .keypoints {
    position: relative;
    background: var(--accent-soft);
    border: 1px solid var(--accent-deep);
    border-radius: 14px;
    padding: 34px 28px 26px;
    margin: 8px 0 40px;
  }
  .keypoints-badge {
    position: absolute;
    top: -15px;
    left: 22px;
    display: inline-block;
    background: var(--ink);
    color: #fff;
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 13px;
    letter-spacing: 0.12em;
    padding: 9px 16px;
    border-radius: 8px;
  }
  .keypoints-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 16px; }
  .keypoints-list li {
    position: relative;
    padding-left: 26px;
    font-family: var(--font-sans);
    font-size: 19px;
    font-weight: 700;
    line-height: 1.55;
    color: var(--ink);
  }
  .keypoints-list li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.55em;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent-ink);
  }
  @media (max-width: 600px) {
    .keypoints { padding: 30px 20px 22px; }
    .keypoints-list li { font-size: 17px; }
  }

  /* Tag chips (filed under) — link to /tag archive pages for SEO + discovery */
  .art-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px; }
  .art-tag {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 700;
    color: var(--accent-ink);
    background: transparent;
    border: 1.5px solid var(--accent-ink);
    border-radius: 6px;
    padding: 5px 12px;
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .art-tag:hover { background: var(--accent); border-color: var(--accent-ink); color: var(--on-accent); }
</style>
