---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PostGrid from '../../components/PostGrid.astro';
import { categories } from '../../data/categories';
import { postsByCategory, howToCount } from '../../data/posts';
import { howToTopics } from '../../data/howto';

export function getStaticPaths() {
  return categories.map((c) => ({
    params: { category: c.slug },
    props: { category: c },
  }));
}

const { category } = Astro.props;
const posts = postsByCategory(category.slug);

// How-to gets a sub-nav of its topics (each links to a tag archive).
const subNav =
  category.slug === 'how-to'
    ? howToTopics.map((t) => ({ ...t, count: howToCount(t.slug) }))
    : [];

const crumbs = [
  { name: 'หน้าแรก', href: '/' },
  { name: category.label, href: `/${category.slug}` },
];
---

<BaseLayout
  title={`${category.label} | TorPenguin`}
  description={category.description}
  breadcrumbs={crumbs}
>
  <section class="pillar-head">
    <div class="container">
      <Breadcrumb items={crumbs} />
      <h1 class="pillar-title">{category.label}</h1>
      <p class="pillar-intent">{category.intent}</p>
      <p class="pillar-desc">{category.description}</p>

      {subNav.length > 0 && (
        <nav class="subnav" aria-label="หัวข้อย่อย How-to">
          {subNav.map((t) =>
            t.count > 0 ? (
              <a href={`/tag/${t.slug}`} class="subnav-chip">
                {t.label}<span class="subnav-th">{t.th}</span>
              </a>
            ) : (
              <span class="subnav-chip is-disabled">
                {t.label}<span class="subnav-th">{t.th}</span>
              </span>
            ),
          )}
        </nav>
      )}
    </div>
  </section>

  <section class="pillar-body">
    <div class="container">
      {posts.length === 0 ? (
        <p class="pillar-empty">หมวดนี้กำลังจะมีเรื่องเร็วๆนี้ ระหว่างนี้ตามอ่านหมวดอื่นของพวกเราไปก่อนได้</p>
      ) : (
        <PostGrid posts={posts} cols={3} />
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .pillar-head { padding: 28px 0 32px; border-bottom: 1px solid var(--hairline); }
  .pillar-title {
    font-family: var(--font-sans);
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 18px 0 8px;
    line-height: 1.1;
  }
  .pillar-intent {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-ink);
    margin-bottom: 16px;
  }
  .pillar-desc {
    font-size: 18px;
    line-height: 1.8;
    color: var(--ink-soft);
    max-width: 720px;
  }
  .pillar-body { padding: 40px 0 64px; }
  .pillar-empty { font-size: 17px; color: var(--ink-soft); padding: 24px 0; }
  .subnav {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px;
  }
  .subnav-chip {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    padding: 9px 16px;
    border: 1px solid var(--hairline-strong);
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--hairline-strong);
    transition: border-color 0.15s ease, background 0.15s ease, color 0.15s ease;
  }
  .subnav-chip:hover {
    border-color: var(--ink);
    color: var(--ink);
  }
  .subnav-chip .subnav-th {
    font-size: 12px;
    font-weight: 500;
    color: var(--ink-faint);
  }
  .subnav-chip.is-disabled {
    color: var(--ink-mute);
    border-color: var(--hairline);
    cursor: default;
  }
  .subnav-chip.is-disabled .subnav-th { color: var(--ink-mute); }
</style>
