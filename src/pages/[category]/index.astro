---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryListing from '../../components/CategoryListing.astro';
import { categories, PAGE_SIZE } from '../../data/categories';
import { getPostsByCategory } from '../../lib/content';

export function getStaticPaths() {
  return categories.map((c) => ({ params: { category: c.slug }, props: { category: c } }));
}

const { category } = Astro.props;
const all = await getPostsByCategory(category.slug);
const totalPages = Math.max(1, Math.ceil(all.length / PAGE_SIZE));
const posts = all.slice(0, PAGE_SIZE);

const crumbs = [
  { name: 'หน้าแรก', href: '/' },
  { name: category.label, href: `/${category.slug}` },
];
---

<BaseLayout
  title={`${category.label} | TorPenguin`}
  description={category.description}
  breadcrumbs={crumbs}
>
  <CategoryListing category={category} posts={posts} currentPage={1} totalPages={totalPages} />
</BaseLayout>
