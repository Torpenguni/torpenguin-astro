---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const crumbs = [
  { name: 'หน้าแรก', href: '/' },
  { name: 'ติดต่อ', href: '/contact' },
];

const items = [
  { label: 'เรื่องทั่วไป', value: 'hello@torpenguin.com', note: 'ทักทาย เสนอเรื่องที่อยากให้เราเล่า หรือมีอะไรอยากบอก' },
  { label: 'ร่วมงาน / โฆษณา', value: 'partner@torpenguin.com', note: 'Sponsored content และแคมเปญร่วมกับแบรนด์' },
  { label: 'แจ้งข้อมูลผิดพลาด', value: 'editor@torpenguin.com', note: 'เจอข้อมูลที่คลาดเคลื่อน บอกเราได้เลย เราแก้และบันทึกการแก้ไว้เสมอ' },
];

const YOUTUBE = 'https://www.youtube.com/@torpenguin';
const FACEBOOK = 'https://www.facebook.com/torpenguin';
---

<BaseLayout
  title="ติดต่อ | TorPenguin"
  description="ช่องทางติดต่อทีม TorPenguin ทั้งเรื่องทั่วไป ร่วมงานกับแบรนด์ และแจ้งข้อมูลผิดพลาด"
  breadcrumbs={crumbs}
>
  <section class="page">
    <div class="container-narrow">
      <Breadcrumb items={crumbs} />
      <h1 class="page-h1">ติดต่อเรา</h1>
      <p class="lead">เราอ่านทุกข้อความ และพยายามตอบกลับให้เร็วที่สุด</p>

      <ul class="contact-list">
        {items.map((c) => (
          <li>
            <div class="c-label">{c.label}</div>
            <a class="c-value" href={`mailto:${c.value}`}>{c.value}</a>
            <p class="c-note">{c.note}</p>
          </li>
        ))}
      </ul>

      <div class="social-row">
        <span>ตามเราได้ที่</span>
        <a href={YOUTUBE} target="_blank" rel="noopener noreferrer">YouTube ↗</a>
        <a href={FACEBOOK} target="_blank" rel="noopener noreferrer">Facebook ↗</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page { padding: 28px 0 72px; }
  .page-h1 { font-family: var(--font-sans); font-size: clamp(30px, 5vw, 44px); font-weight: 800; color: var(--ink); margin: 18px 0 8px; }
  .lead { font-size: 18px; color: var(--ink-soft); margin-bottom: 36px; }
  .contact-list { list-style: none; margin: 0; padding: 0; }
  .contact-list li { padding: 22px 0; border-bottom: 1px solid var(--hairline); }
  .c-label { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-faint); margin-bottom: 8px; }
  .c-value { font-family: var(--font-sans); font-size: 20px; font-weight: 700; color: var(--ink); text-decoration: none; border-bottom: none; }
  .c-value:hover { color: var(--accent); }
  .c-note { font-size: 15px; line-height: 1.7; color: var(--ink-soft); margin-top: 6px; }
  .social-row { display: flex; align-items: center; gap: 16px; margin-top: 32px; font-size: 15px; color: var(--ink-soft); }
  .social-row a { font-weight: 600; color: var(--accent); text-decoration: none; border-bottom: none; }
</style>
