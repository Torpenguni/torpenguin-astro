---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const crumbs = [
  { name: 'หน้าแรก', href: '/' },
  { name: 'ความเป็นส่วนตัว', href: '/privacy' },
];

const sections = [
  {
    head: 'ข้อมูลที่เราเก็บ',
    body: 'เราเก็บเท่าที่จำเป็นต่อการให้บริการเว็บ เช่น อีเมลของคนที่สมัครรับข่าวสาร และข้อมูลสถิติการใช้งานแบบไม่ระบุตัวตนว่าหน้าไหนถูกอ่านบ้าง เราไม่เก็บข้อมูลการเงิน และไม่ใช้ตัวติดตามโฆษณาจากภายนอก',
  },
  {
    head: 'เราใช้ข้อมูลทำอะไร',
    body: 'อีเมลใช้ส่งจดหมายข่าวและเรื่องที่เกี่ยวกับการสมัครเท่านั้น ข้อมูลสถิติใช้แบบรวมเพื่อเข้าใจว่าเนื้อหาแบบไหนมีประโยชน์กับทุกคน ข้อความที่ส่งมาหาเราใช้เพื่อตอบกลับเรื่องนั้นๆ',
  },
  {
    head: 'สิ่งที่เราไม่ทำ',
    body: 'เราไม่ขาย ไม่ให้เช่า และไม่แชร์รายชื่อผู้รับข่าวสารกับใคร เราไม่ฝังโฆษณาหรือพิกเซลติดตามพฤติกรรมเพื่อยิงโฆษณา',
  },
  {
    head: 'คุกกี้',
    body: 'เราใช้คุกกี้เท่าที่จำเป็นต่อการทำงานของเว็บ และใช้เครื่องมือวิเคราะห์ที่เคารพความเป็นส่วนตัว ทุกคนล้างคุกกี้ได้ตลอดเวลาผ่านเบราว์เซอร์',
  },
  {
    head: 'สิทธิของทุกคน',
    body: 'ยกเลิกรับข่าวสารได้ด้วยคลิกเดียวในอีเมล และขอดูหรือขอลบข้อมูลส่วนตัวที่เรามีได้ โดยส่งเมลมาที่ privacy@torpenguin.com เราจะดำเนินการให้ภายใน 30 วัน',
  },
];
---

<BaseLayout
  title="ความเป็นส่วนตัว | TorPenguin"
  description="TorPenguin เก็บและใช้ข้อมูลของผู้อ่านอย่างไร สรุปสั้นๆคือเท่าที่จำเป็น โปร่งใส และไม่เคยใช้เพื่อโฆษณา"
  breadcrumbs={crumbs}
>
  <section class="legal">
    <div class="container-narrow">
      <Breadcrumb items={crumbs} />
      <h1 class="legal-h1">ความเป็นส่วนตัว</h1>
      <p class="legal-lead">สรุปสั้นๆ เราเก็บข้อมูลเท่าที่จำเป็น ไม่ขายข้อมูลผู้อ่าน และไม่มีตัวติดตามโฆษณา รายละเอียดอยู่ด้านล่าง</p>
      {sections.map((s, i) => (
        <article class="legal-sec">
          <div class="legal-num">{String(i + 1).padStart(2, '0')}</div>
          <h2 class="legal-head">{s.head}</h2>
          <p class="legal-body">{s.body}</p>
        </article>
      ))}
      <p class="legal-contact">มีคำถามเรื่องนี้ ส่งมาที่ <a href="mailto:privacy@torpenguin.com">privacy@torpenguin.com</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .legal { padding: 28px 0 80px; }
  .legal-h1 { font-family: var(--font-sans); font-size: clamp(30px, 5vw, 44px); font-weight: 800; color: var(--ink); margin: 18px 0 16px; }
  .legal-lead { font-size: 18px; line-height: 1.7; color: var(--ink-soft); max-width: 680px; margin-bottom: 32px; }
  .legal-sec { padding: 28px 0; border-top: 1px solid var(--hairline); max-width: 680px; }
  .legal-num { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.1em; color: var(--accent-ink); margin-bottom: 10px; }
  .legal-head { font-family: var(--font-sans); font-size: 22px; font-weight: 700; color: var(--ink); margin-bottom: 10px; }
  .legal-body { font-size: 17px; line-height: 1.8; color: var(--ink-soft); }
  .legal-contact { margin-top: 32px; font-size: 16px; color: var(--ink-soft); }
  .legal-contact a { color: var(--accent-ink); }
</style>
