---
import BaseLayout from '../layouts/BaseLayout.astro';
import { categories } from '../data/categories';
---

<BaseLayout
  title="ไม่พบหน้านี้ | TorPenguin"
  description="ไม่พบหน้าที่ทุกคนกำลังหา"
  noindex={true}
>
  <section class="nf">
    <div class="container-narrow">
      <div class="nf-code">404</div>
      <h1 class="nf-h1">ไม่เจอหน้านี้</h1>
      <p class="nf-dek">หน้าที่ทุกคนกำลังหาอาจถูกย้ายหรือไม่มีอยู่แล้ว ลองกลับไปหน้าแรกหรือเลือกหมวดที่สนใจ</p>

      <a href="/" class="nf-home">กลับหน้าแรก →</a>

      <div class="nf-cats">
        {categories.map((c) => (
          <a href={`/${c.slug}`}>{c.label}</a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf { padding: 96px 0 120px; text-align: center; }
  .nf-code { font-family: var(--font-mono); font-size: 14px; letter-spacing: 0.15em; color: var(--accent); margin-bottom: 16px; }
  .nf-h1 { font-family: var(--font-sans); font-size: clamp(32px, 5vw, 48px); font-weight: 800; color: var(--ink); margin-bottom: 16px; }
  .nf-dek { font-size: 18px; line-height: 1.7; color: var(--ink-soft); max-width: 520px; margin: 0 auto 32px; }
  .nf-home {
    display: inline-block;
    font-family: var(--font-sans); font-weight: 600; font-size: 15px;
    padding: 13px 24px; background: var(--accent); color: var(--on-accent);
    border-radius: 8px; text-decoration: none; border-bottom: none;
  }
  .nf-home:hover { background: var(--accent-deep); }
  .nf-cats { display: flex; flex-wrap: wrap; gap: 8px 18px; justify-content: center; margin-top: 32px; }
  .nf-cats a { font-size: 14px; color: var(--ink-soft); text-decoration: none; border-bottom: none; }
  .nf-cats a:hover { color: var(--accent); }
</style>
