---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = 'About — Torpenguin';
const pageDescription = "Torpenguin built Penguin Eat Shabu (40+ outlets in Bangkok) and writes about building, operating, and scaling F&B in Asia.";

const facts = [
  { label: 'Built', value: 'Penguin Eat Shabu — 40+ outlets' },
  { label: 'Based', value: 'Bangkok, Thailand' },
  { label: 'Also runs', value: 'SpoonAsia — F&B intelligence' },
  { label: 'Writes about', value: 'Building · Operations · Scaling' },
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <section class="hero">
    <div class="container-narrow">
      <div class="section-tag">▍ About</div>
      <h1 class="hero-h1">
        I build restaurants. <em>Then I write about it.</em>
      </h1>
      <p class="hero-dek">
        I'm Torpenguin. Over the last decade I built Penguin Eat Shabu from a
        single shop into a 40+ outlet brand across Bangkok. This site is where
        I write down what that actually took.
      </p>
    </div>
  </section>

  <section class="story">
    <div class="container-narrow">
      <div class="facts">
        {facts.map((f) => (
          <div class="fact">
            <div class="fact-label">{f.label}</div>
            <div class="fact-value">{f.value}</div>
          </div>
        ))}
      </div>

      <div class="prose">
        <p>
          I didn't set out to run forty restaurants. I set out to run one good
          one. The rest came from a decade of opening, closing, reformatting,
          and repricing — learning the hard way which decisions compound and
          which ones quietly sink you.
        </p>
        <p>
          Most of what I learned never appeared in any course, deck, or
          industry report. The genuinely useful lessons were specific,
          uncomfortable, and hard-won: how to read a lease against realistic
          table turns, when to let a manager go, why the fifth outlet is harder
          than the fortieth.
        </p>
        <p>
          Today I also run <a href="https://spoonasia.com" target="_blank" rel="noopener noreferrer">SpoonAsia</a>,
          a publication decoding Thailand's F&B market for investors and
          operators. <strong>This site is separate.</strong> It's just me, in
          the first person, writing about the craft of building and running
          these businesses.
        </p>
        <p>
          No fabricated precision. No newsletter funnel dressed up as wisdom.
          Just notes from someone still in the arena — written when there's
          something worth saying.
        </p>
      </div>

      <div class="about-cta">
        <a href="/essays" class="btn">Read the essays</a>
        <a href="#subscribe" class="btn btn-inverted">Subscribe</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .section-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 16px;
  }

  .hero {
    padding: 48px 0 32px;
    border-bottom: 1px solid var(--hairline);
  }
  .hero-h1 {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: clamp(32px, 4.4vw, 48px);
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--ink);
    margin: 0 0 24px;
  }
  .hero-h1 em {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    color: var(--accent);
  }
  .hero-dek {
    font-family: var(--font-serif);
    font-size: clamp(18px, 2vw, 21px);
    line-height: 1.55;
    color: var(--ink-soft);
    margin: 0;
    max-width: 640px;
  }

  .story {
    padding: 48px 0 80px;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    border-top: 1px solid var(--ink);
    margin-bottom: 48px;
  }
  .fact {
    padding: 20px 24px 20px 0;
    border-bottom: 0.5px solid var(--hairline);
  }
  .fact-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 8px;
  }
  .fact-value {
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 600;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  .prose {
    max-width: 640px;
  }
  .prose p {
    font-family: var(--font-serif);
    font-size: 18px;
    line-height: 1.75;
    color: var(--ink);
    margin: 0 0 24px;
  }
  .prose strong { font-weight: 600; }
  .prose a {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 0.5px;
    text-underline-offset: 2px;
    border-bottom: none;
  }
  .prose a:hover { color: var(--accent-deep); }

  .about-cta {
    display: flex;
    gap: 12px;
    margin-top: 40px;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .facts { grid-template-columns: 1fr; }
    .fact { padding-right: 0; }
  }
</style>
