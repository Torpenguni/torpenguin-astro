---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const crumbs = [
  { name: 'หน้าแรก', href: '/' },
  { name: 'เกี่ยวกับเรา', href: '/about' },
];
---

<BaseLayout
  title="เกี่ยวกับเรา | TorPenguin"
  description="TorPenguin คือสื่อธุรกิจอาหารและร้านอาหารที่เล่าเรื่องเจาะลึกจากคนที่ลงมือทำจริง เราอยากให้ทุกคนที่ทำร้านตัดสินใจได้ดีขึ้น"
  breadcrumbs={crumbs}
>
  <section class="page">
    <div class="container-narrow">
      <Breadcrumb items={crumbs} />
      <h1 class="page-h1">เราเล่าเรื่องธุรกิจอาหารแบบที่อยากอ่านเอง</h1>

      <div class="prose">
        <p>TorPenguin คือสื่อเรื่องธุรกิจอาหารและร้านอาหาร เราโตมาจากการทำคอนเทนต์บน YouTube และ Facebook ที่มีคนติดตามรวมกันมากกว่า 1.5 ล้านคน เว็บนี้คือบ้านอีกหลังของพวกเรา ที่ตั้งใจเก็บความรู้ให้ค้นเจอง่ายและอ่านได้ยาวๆ</p>

        <p>สิ่งที่เราสนใจไม่ใช่ข่าวผิวเผิน แต่เป็นเบื้องหลังการตัดสินใจ ทำไมร้านนี้โต ทำไมร้านนั้นไปไม่รอด เปิดร้านแบบนี้ใช้เงินเท่าไหร่ และคุ้มจริงไหม เราอยากให้ทุกคนที่กำลังจะเปิดร้านหรือทำร้านอยู่แล้ว ตัดสินใจได้ดีขึ้นจากข้อมูลจริง</p>

        <h2>เราทำงานยังไง</h2>
        <p>เราเล่าจากของจริง คุยกับเจ้าของร้านตัวจริง และอ้างอิงแหล่งที่มาทุกครั้งที่ทำได้ ถ้าเรื่องไหนเป็นการประเมิน เราจะบอกตรงๆว่าเป็นการประเมิน เราไม่ขายฝัน และไม่ทำให้ตัวเลขดูแน่นอนเกินกว่าที่มันเป็น</p>

        <h2>หมวดที่เราเล่า</h2>
        <p>เราจัดเรื่องเป็นหกหมวดตามสิ่งที่ทุกคนอยากรู้ ตั้งแต่ News ข่าวสด, Case Studies ถอดบทเรียน, Trends ทิศทางตลาด, Interviews คุยกับคนตัวจริง, How-to วิธีลงมือทำ ไปจนถึง Feasibility วิเคราะห์ความคุ้มก่อนลงทุน</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page { padding: 28px 0 72px; }
  .page-h1 {
    font-family: var(--font-sans);
    font-size: clamp(30px, 5vw, 44px);
    font-weight: 800;
    line-height: 1.3;
    color: var(--ink);
    margin: 18px 0 28px;
  }
  .prose { font-size: 19px; line-height: 1.9; color: var(--ink); max-width: 720px; }
  .prose p { margin-bottom: 22px; }
  .prose h2 { font-family: var(--font-sans); font-size: 26px; font-weight: 700; margin: 36px 0 14px; color: var(--ink); }
</style>
