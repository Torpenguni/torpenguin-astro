---
import { categories } from '../data/categories';

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  currentPath === href || currentPath.startsWith(href + '/');

const YOUTUBE = 'https://www.youtube.com/@torpenguin';
const FACEBOOK = 'https://www.facebook.com/torpenguin';

const secondary = [
  { label: 'เกี่ยวกับเรา', href: '/about' },
  { label: 'ร่วมงานกับเรา', href: '/partner' },
  { label: 'ติดต่อ', href: '/contact' },
];
---

<header class="masthead">
  <div class="container">
    <div class="masthead-inner">
      <a href="/" class="logo" aria-label="TorPenguin หน้าแรก">
        <img src="/penguin.png" class="logo-mark" alt="" aria-hidden="true" width="40" height="40" />
        <span class="logo-word">torpenguin</span>
      </a>

      <div class="masthead-right">
        <a href={YOUTUBE} class="social" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.2 3.6Z"/></svg>
        </a>
        <a href={FACEBOOK} class="social" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12a12 12 0 1 0-13.9 11.9v-8.4H7.1V12h3V9.4c0-3 1.8-4.6 4.5-4.6 1.3 0 2.6.2 2.6.2v2.9h-1.5c-1.5 0-1.9.9-1.9 1.8V12h3.3l-.5 3.5h-2.8v8.4A12 12 0 0 0 24 12Z"/></svg>
        </a>
        <a href="/search" class="search-btn" aria-label="ค้นหา">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </a>
        <button class="hamburger" aria-label="เปิดเมนู" aria-expanded="false" data-menu-toggle>
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>
  </div>
</header>

<nav class="primary-nav" aria-label="หมวดหลัก">
  <div class="container">
    <div class="primary-nav-inner">
      {categories.map((c) => (
        <a href={`/${c.slug}`} class={`primary-nav-link ${isActive(`/${c.slug}`) ? 'active' : ''}`}>
          {c.label}
        </a>
      ))}
      <a href="/about" class={`primary-nav-link ${isActive('/about') ? 'active' : ''}`}>About</a>
    </div>
  </div>
</nav>

<!-- Mobile drawer -->
<div class="drawer" data-drawer hidden>
  <nav class="drawer-inner" aria-label="เมนูมือถือ">
    {categories.map((c) => (
      <a href={`/${c.slug}`} class={`drawer-link ${isActive(`/${c.slug}`) ? 'active' : ''}`}>{c.label}</a>
    ))}
    <div class="drawer-sep"></div>
    {secondary.map((s) => (
      <a href={s.href} class="drawer-link drawer-link-soft">{s.label}</a>
    ))}
    <div class="drawer-social">
      <a href={YOUTUBE} target="_blank" rel="noopener noreferrer">YouTube</a>
      <a href={FACEBOOK} target="_blank" rel="noopener noreferrer">Facebook</a>
    </div>
  </nav>
</div>

<script>
  const toggle = document.querySelector('[data-menu-toggle]');
  const drawer = document.querySelector('[data-drawer]');
  toggle?.addEventListener('click', () => {
    const open = drawer?.hasAttribute('hidden');
    if (open) drawer?.removeAttribute('hidden');
    else drawer?.setAttribute('hidden', '');
    toggle.setAttribute('aria-expanded', String(!!open));
    document.body.style.overflow = open ? 'hidden' : '';
  });
</script>

<style>
  .masthead {
    background: var(--paper);
    padding: 16px 0;
    border-bottom: 1px solid var(--hairline);
  }
  .masthead-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    border-bottom: none;
  }
  .logo-mark { width: 40px; height: 40px; border-radius: 50%; display: block; flex-shrink: 0; }
  .logo-word {
    font-family: var(--font-brand);
    font-weight: 800;
    font-size: 28px;
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  .logo:hover .logo-word { color: var(--accent-ink); }

  .masthead-right { display: flex; align-items: center; gap: 8px; }
  .social, .search-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    color: var(--ink-soft);
    background: transparent;
    border: none;
    cursor: pointer;
    border-radius: 6px;
    text-decoration: none;
    transition: color 0.15s ease, background 0.15s ease;
  }
  .social:hover, .search-btn:hover { color: var(--accent-ink); background: var(--paper-soft); }

  .hamburger {
    display: none;
    flex-direction: column;
    gap: 4px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 8px;
  }
  .hamburger span { display: block; width: 22px; height: 2px; background: var(--ink); }

  .primary-nav {
    background: var(--paper);
    border-bottom: 2px solid var(--ink);
    position: sticky;
    top: 0;
    z-index: 40;
  }
  .primary-nav-inner {
    display: flex;
    align-items: center;
    gap: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .primary-nav-inner::-webkit-scrollbar { display: none; }
  .primary-nav-link {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    border-bottom: none;
    padding: 14px 18px;
    white-space: nowrap;
    position: relative;
    transition: color 0.15s ease;
  }
  .primary-nav-link:first-child { padding-left: 0; }
  .primary-nav-link:hover { color: var(--accent-ink); }
  .primary-nav-link.active { color: var(--accent-ink); }
  .primary-nav-link.active::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 18px;
    right: 18px;
    height: 3px;
    background: var(--accent);
  }
  .primary-nav-link.active:first-child::after { left: 0; }

  /* Drawer */
  .drawer {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: var(--paper);
    padding: 24px 24px 48px;
    overflow-y: auto;
  }
  .drawer-inner { display: flex; flex-direction: column; gap: 2px; max-width: 480px; }
  .drawer-link {
    font-family: var(--font-sans);
    font-size: 22px;
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
    border-bottom: none;
    padding: 14px 0;
  }
  .drawer-link.active { color: var(--accent-ink); }
  .drawer-link-soft { font-size: 17px; font-weight: 500; color: var(--ink-soft); padding: 10px 0; }
  .drawer-sep { height: 1px; background: var(--hairline); margin: 16px 0; }
  .drawer-social { display: flex; gap: 18px; margin-top: 20px; }
  .drawer-social a {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-ink);
    text-decoration: none;
    border-bottom: none;
  }

  @media (max-width: 820px) {
    .logo-word { font-size: 22px; }
    .social { display: none; }
    .hamburger { display: flex; }
    .primary-nav { display: none; }
  }
</style>
