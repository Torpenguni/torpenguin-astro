---
const currentPath = Astro.url.pathname;

const primaryItems = [
  { label: 'Essays',  href: '/essays' },
  { label: 'Topics',  href: '/topics' },
  { label: 'About',   href: '/about' },
  { label: 'Contact', href: '/contact' },
];

const today = new Date().toLocaleDateString('en-US', {
  weekday: 'long', year: 'numeric', month: 'long', day: 'numeric',
});
---

<header class="masthead">
  <div class="container">
    <div class="masthead-inner">
      <button class="hamburger" aria-label="Open menu">
        <span></span><span></span><span></span>
      </button>

      <div class="masthead-left">
        <span class="masthead-date">{today}</span>
      </div>

      <div class="masthead-center">
        <a href="/" class="masthead-logo" aria-label="Torpenguin home">
          <span class="logo-bold">tor</span><span class="logo-light">penguin</span><span class="logo-dot" aria-hidden="true"></span>
        </a>
        <span class="masthead-tagline">Notes on building F&amp;B in Asia</span>
      </div>

      <div class="masthead-right">
        <a href="#subscribe" class="subscribe-btn">Subscribe</a>
      </div>
    </div>
  </div>
</header>

<nav class="primary-nav">
  <div class="container">
    <div class="primary-nav-inner">
      {primaryItems.map((item) => {
        const isActive = currentPath === item.href || currentPath.startsWith(item.href + '/');
        return (
          <a href={item.href} class={`primary-nav-link ${isActive ? 'active' : ''}`}>
            {item.label}
          </a>
        );
      })}
    </div>
  </div>
</nav>

<style>
  .masthead {
    background: var(--paper);
    padding: 20px 0 16px;
    border-bottom: 1px solid var(--hairline);
  }

  .masthead-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
  }

  .hamburger {
    display: none;
    flex-direction: column;
    gap: 4px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 8px;
  }
  .hamburger span { display: block; width: 20px; height: 2px; background: var(--ink); }

  .masthead-left { display: flex; align-items: center; }
  .masthead-date {
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--ink-soft);
    font-weight: 500;
  }

  .masthead-center {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .masthead-logo {
    font-family: var(--font-sans);
    font-size: 42px;
    letter-spacing: -0.03em;
    color: var(--ink);
    text-decoration: none;
    border-bottom: none;
    line-height: 1;
    display: inline-flex;
    align-items: baseline;
    gap: 0;
    transition: color 0.15s ease;
  }

  .masthead-tagline {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .logo-bold { font-weight: 800; }
  .logo-light { font-weight: 400; }
  .logo-dot {
    display: inline-block;
    width: 0.18em;
    height: 0.18em;
    background: var(--accent);
    margin-left: 0.04em;
    align-self: flex-end;
    margin-bottom: 0.04em;
  }
  .masthead-logo:hover { color: var(--accent); }
  .masthead-logo:hover .logo-dot { background: var(--accent-deep); }

  .masthead-right {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 12px;
  }

  .subscribe-btn {
    display: inline-block;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    padding: 9px 18px;
    text-decoration: none;
    border: none;
    border-bottom: none;
    border-radius: 2px;
    transition: background 0.15s ease;
    letter-spacing: 0.01em;
  }
  .subscribe-btn:hover { background: var(--accent); color: var(--paper); }

  .primary-nav {
    background: var(--paper);
    border-bottom: 1px solid var(--ink);
  }

  .primary-nav-inner {
    display: flex;
    gap: 0;
    align-items: center;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .primary-nav-inner::-webkit-scrollbar { display: none; }

  .primary-nav-link {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    border-bottom: none;
    padding: 14px 16px;
    white-space: nowrap;
    letter-spacing: -0.005em;
    position: relative;
    transition: color 0.15s ease;
  }
  .primary-nav-link:first-child { padding-left: 0; }
  .primary-nav-link:hover { color: var(--accent); }
  .primary-nav-link.active::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 16px;
    right: 16px;
    height: 3px;
    background: var(--accent);
  }
  .primary-nav-link.active:first-child::after { left: 0; }

  @media (max-width: 768px) {
    .masthead-inner {
      grid-template-columns: auto 1fr auto;
    }
    .hamburger { display: flex; }
    .masthead-left { display: none; }
    .masthead-logo { font-size: 28px; }
    .masthead-tagline { display: none; }
    .subscribe-btn { font-size: 12px; padding: 7px 14px; }
    .primary-nav-link { font-size: 13px; padding: 12px 12px; }
  }
</style>
