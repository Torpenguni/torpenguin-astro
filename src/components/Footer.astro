---
import { categories } from '../data/categories';

const currentYear = new Date().getFullYear();
const YOUTUBE = 'https://www.youtube.com/@torpenguin';
const FACEBOOK = 'https://www.facebook.com/torpenguin';

const aboutLinks = [
  { label: 'เกี่ยวกับเรา', href: '/about' },
  { label: 'ร่วมงานกับเรา', href: '/partner' },
  { label: 'ติดต่อ', href: '/contact' },
];
const channelLinks = [
  { label: 'วิดีโอ', href: '/watch' },
  { label: 'YouTube', href: YOUTUBE, external: true },
  { label: 'Facebook', href: FACEBOOK, external: true },
  { label: 'RSS', href: '/rss.xml' },
];
---

<footer class="tp-footer">
  <div class="container">

    <div class="tp-newsletter" id="subscribe">
      <div>
        <h2 class="tp-news-head">ของดีเรื่องธุรกิจอาหาร ส่งตรงถึงเมลทุกคน</h2>
        <p class="tp-news-sub">เราคัดเรื่องที่คนทำร้านต้องรู้มาให้อ่านก่อนใคร ไม่มีสแปม ไม่มีขายของ</p>
      </div>
      <form class="tp-news-form" onsubmit="event.preventDefault()">
        <input type="email" class="tp-news-input" placeholder="อีเมลของคุณ" aria-label="อีเมล" required />
        <button type="submit" class="tp-news-btn">รับข่าวสาร</button>
      </form>
    </div>

    <div class="tp-footer-main">
      <div class="tp-footer-brand">
        <div class="tp-logo">
          <img src="/penguin.png" width="36" height="36" alt="" aria-hidden="true" />
          <span>torpenguin</span>
        </div>
        <p class="tp-tagline">สื่อธุรกิจอาหารและร้านอาหาร เจาะลึกเรื่องที่คนทำร้านต้องรู้ เล่าจากคนที่ลงมือทำจริง</p>
      </div>

      <div class="tp-footer-cols">
        <div class="tp-col">
          <div class="tp-col-title">หมวดหลัก</div>
          <ul>
            {categories.map((c) => (
              <li><a href={`/${c.slug}`}>{c.label}</a></li>
            ))}
          </ul>
        </div>
        <div class="tp-col">
          <div class="tp-col-title">เกี่ยวกับ</div>
          <ul>
            {aboutLinks.map((l) => (
              <li><a href={l.href}>{l.label}</a></li>
            ))}
          </ul>
        </div>
        <div class="tp-col">
          <div class="tp-col-title">ช่องทาง</div>
          <ul>
            {channelLinks.map((l) => (
              <li>
                <a href={l.href} target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener noreferrer' : undefined}>
                  {l.label}{l.external ? ' ↗' : ''}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <div class="tp-footer-bottom">
      <div>© {currentYear} TorPenguin</div>
      <div class="tp-footer-mini">
        <a href="/privacy">ความเป็นส่วนตัว</a>
        <span class="sep">·</span>
        <a href="/terms">เงื่อนไขการใช้งาน</a>
        <span class="sep">·</span>
        <span class="tp-eco">ส่วนหนึ่งของระบบ Penguin X</span>
      </div>
    </div>

  </div>
</footer>

<style>
  .tp-footer {
    background: var(--paper-soft);
    border-top: 1px solid var(--hairline);
    margin-top: 80px;
  }

  .tp-newsletter {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 40px;
    align-items: center;
    padding: 56px 0;
    border-bottom: 1px solid var(--hairline);
  }
  .tp-news-head {
    font-family: var(--font-sans);
    font-size: 26px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--ink);
    margin-bottom: 10px;
  }
  .tp-news-sub { font-size: 16px; color: var(--ink-soft); }
  .tp-news-form { display: flex; gap: 8px; }
  .tp-news-input {
    flex: 1;
    font-family: var(--font-sans);
    font-size: 16px;
    padding: 13px 16px;
    border: 1px solid var(--hairline-strong);
    border-radius: 8px;
    background: var(--paper);
    color: var(--ink);
    outline: none;
  }
  .tp-news-input:focus { border-color: var(--accent); }
  .tp-news-btn {
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 600;
    padding: 13px 22px;
    background: var(--accent);
    color: #fff;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.15s ease;
  }
  .tp-news-btn:hover { background: var(--accent-deep); }

  .tp-footer-main {
    display: grid;
    grid-template-columns: 1.3fr 2fr;
    gap: 48px;
    padding: 56px 0;
    border-bottom: 1px solid var(--hairline);
  }
  .tp-logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-brand);
    font-weight: 800;
    font-size: 24px;
    letter-spacing: -0.03em;
    color: var(--ink);
    margin-bottom: 14px;
  }
  .tp-logo img { border-radius: 50%; }
  .tp-tagline { font-size: 15px; line-height: 1.7; color: var(--ink-soft); max-width: 380px; }

  .tp-footer-cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  .tp-col-title {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 14px;
  }
  .tp-col ul { list-style: none; margin: 0; padding: 0; }
  .tp-col li { margin-bottom: 10px; }
  .tp-col a {
    font-size: 15px;
    color: var(--ink);
    text-decoration: none;
    border-bottom: none;
    transition: color 0.15s ease;
  }
  .tp-col a:hover { color: var(--accent); }

  .tp-footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    padding: 22px 0;
    font-size: 13px;
    color: var(--ink-faint);
  }
  .tp-footer-mini { display: flex; align-items: center; gap: 10px; }
  .tp-footer-mini a { color: var(--ink-faint); text-decoration: none; border-bottom: none; }
  .tp-footer-mini a:hover { color: var(--ink); }
  .tp-footer-mini .sep { color: var(--hairline-strong); }
  .tp-eco { color: var(--ink-mute); }

  @media (max-width: 820px) {
    .tp-newsletter { grid-template-columns: 1fr; gap: 20px; padding: 40px 0; }
    .tp-footer-main { grid-template-columns: 1fr; gap: 36px; padding: 40px 0; }
    .tp-news-form { flex-direction: column; }
    .tp-news-btn { width: 100%; }
  }
  @media (max-width: 520px) {
    .tp-footer-cols { grid-template-columns: 1fr 1fr; }
  }
</style>
